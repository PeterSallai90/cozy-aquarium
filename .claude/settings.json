{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git restore *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git stash *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git lfs *)",
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Bash(gh label *)",
      "Bash(gh project *)",
      "Bash(gh run *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh ruleset list *)",
      "Bash(gh ruleset view *)",
      "Bash(gh api *)",
      "Bash(godot_console *)",
      "Bash(gdlint *)",
      "Bash(gdformat *)",
      "Bash(py *)",
      "Bash(blender *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git branch *)",
      "PowerShell(git switch *)",
      "PowerShell(git checkout *)",
      "PowerShell(git add *)",
      "PowerShell(git restore *)",
      "PowerShell(git rm *)",
      "PowerShell(git mv *)",
      "PowerShell(git commit *)",
      "PowerShell(git fetch *)",
      "PowerShell(git pull *)",
      "PowerShell(git push *)",
      "PowerShell(git merge *)",
      "PowerShell(git stash *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git ls-files *)",
      "PowerShell(git lfs *)",
      "PowerShell(gh issue *)",
      "PowerShell(gh pr *)",
      "PowerShell(gh label *)",
      "PowerShell(gh project *)",
      "PowerShell(gh run *)",
      "PowerShell(gh release list *)",
      "PowerShell(gh release view *)",
      "PowerShell(gh ruleset list *)",
      "PowerShell(gh ruleset view *)",
      "PowerShell(gh api *)",
      "PowerShell(godot_console *)",
      "PowerShell(gdlint *)",
      "PowerShell(gdformat *)",
      "PowerShell(py *)",
      "PowerShell(blender *)"
    ],
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *--force*)",
      "Bash(git push * +*)",
      "Bash(gh pr merge *--admin*)",
      "Bash(*--add-label*owner-approved*)",
      "Bash(*--label*owner-approved*)",
      "Bash(* -l owner-approved*)",
      "Bash(gh label * owner-approved*)",
      "Bash(gh api *owner-approved*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api *branches/*/protection*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo delete*)",
      "PowerShell(git push * main)",
      "PowerShell(git push * main *)",
      "PowerShell(git push *:main)",
      "PowerShell(git push *:main *)",
      "PowerShell(git push *refs/heads/main*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push * +*)",
      "PowerShell(gh pr merge *--admin*)",
      "PowerShell(*--add-label*owner-approved*)",
      "PowerShell(*--label*owner-approved*)",
      "PowerShell(* -l owner-approved*)",
      "PowerShell(gh label * owner-approved*)",
      "PowerShell(gh api *owner-approved*)",
      "PowerShell(gh api *rulesets*)",
      "PowerShell(gh api *branches/*/protection*)",
      "PowerShell(gh repo edit*)",
      "PowerShell(gh repo delete*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/require_review.py"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
