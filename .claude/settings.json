  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/require_review.py"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
